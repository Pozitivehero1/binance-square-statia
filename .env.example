# === REQUIRED ===
MISTRAL_API=
REFERRAL_URL=https://example.com/your-referral

# === OPTIONAL MEDIA ===
# Binance Spot market data is public and needs no API key.
# Pexels is optional: if unavailable, the bot generates local abstract motion backgrounds.
PEXELS_API_KEY=

# === CONTENT ===
LANGUAGE=ru
MISTRAL_MODEL=mistral-large-latest
SHORTS_PER_RUN=1
GENERATION_ATTEMPTS=3
SCRIPT_CANDIDATES=3
TOPIC_MODE=mixed
VIDEO_MIN_SECONDS=34
VIDEO_MAX_SECONDS=52
RECENT_TOPIC_LIMIT=60
RECENT_HOOK_LIMIT=80
RECENT_MEDIA_LIMIT=140
PEXELS_PER_PAGE=12

# === VOICE ===
# edge = no separate TTS API key. elevenlabs = higher-end paid voice option.
VOICE_PROVIDER=edge
EDGE_VOICE=auto
EDGE_RATE=+4%
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_FALLBACK=1

# === VIDEO ===
WIDTH=1080
HEIGHT=1920
FPS=30
VIDEO_CRF=18
VIDEO_PRESET=medium
# Put only licensed/royalty-free music into ./music. 0 disables it entirely.
MUSIC_VOLUME=0.055

# === YOUTUBE OPTIONAL ===
AUTO_UPLOAD=0
YOUTUBE_PRIVACY=private
YOUTUBE_CATEGORY_ID=27
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_MADE_FOR_KIDS=0
# Referral/commercial relationship: enabled by default. The bot also writes a disclosure in description.
YOUTUBE_PAID_PROMOTION=1
# Enable only if your generated/altered media falls under YouTube's synthetic-media disclosure requirements.
YOUTUBE_SYNTHETIC_MEDIA=0
